<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive database -->
    <exclude domain="database" path="password_manager.db" />
    
    <!-- Exclude SharedPreferences with credentials -->
    <exclude domain="sharedpref" path="webdav_prefs.xml" />
    <exclude domain="sharedpref" path="biometric_prefs.xml" />
    
    <!-- Exclude sharedprefs directory to be safe -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
